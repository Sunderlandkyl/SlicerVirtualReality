<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>VRViewer</class>
 <widget class="qMRMLWidget" name="VRViewer">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>360</width>
    <height>320</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="ctkCollapsibleButton" name="controlsCollapsibleButton">
     <property name="text">
      <string>Viewer</string>
     </property>
     <layout class="QVBoxLayout" name="controlsLayout">
      <item>
       <layout class="QHBoxLayout" name="buttonsLayout">
        <item>
         <widget class="QPushButton" name="enterButton">
          <property name="toolTip">
           <string>Activate VR and enter the grounded room/turntable viewer.</string>
          </property>
          <property name="text">
           <string>Enter VR Viewer</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="exitButton">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string>Leave viewer mode and restore normal VR navigation.</string>
          </property>
          <property name="text">
           <string>Exit</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="statusLabel">
        <property name="text">
         <string>Not active</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="settingsCollapsibleButton">
     <property name="text">
      <string>Settings</string>
     </property>
     <layout class="QFormLayout" name="settingsLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="rotationSpeedLabel">
        <property name="text">
         <string>Rotation speed (deg/s):</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="rotationSpeedSpinBox">
        <property name="toolTip">
         <string>Turntable angular speed at full left-thumbstick deflection.</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>rotationSpeedDegPerSec</string>
        </property>
        <property name="minimum">
         <double>1.000000000000000</double>
        </property>
        <property name="maximum">
         <double>360.000000000000000</double>
        </property>
        <property name="value">
         <double>45.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="magnificationStepLabel">
        <property name="text">
         <string>Scale step factor:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="magnificationStepSpinBox">
        <property name="toolTip">
         <string>Multiplicative factor applied to world scale on each +/- button press.</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>magnificationStep</string>
        </property>
        <property name="minimum">
         <double>1.010000000000000</double>
        </property>
        <property name="maximum">
         <double>4.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.050000000000000</double>
        </property>
        <property name="value">
         <double>1.250000000000000</double>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="showRoomCheckBox">
        <property name="toolTip">
         <string>Draw the room walls around the turntable.</string>
        </property>
        <property name="text">
         <string>Show room walls</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>showRoom</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QCheckBox" name="fitToTableCheckBox">
        <property name="toolTip">
         <string>Auto-scale the data to span the table on each framing. Off by default so scene views keep a consistent real-world scale.</string>
        </property>
        <property name="text">
         <string>Fit data to table</string>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>fitToTable</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0" colspan="2">
       <widget class="QCheckBox" name="overheadLightCheckBox">
        <property name="toolTip">
         <string>Light the table from an overhead fixture near the ceiling, with softer fill lights derived from it, instead of the VR view's default lighting.</string>
        </property>
        <property name="text">
         <string>Overhead light</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>overheadLight</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>40</height>
      </size>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>ctkCollapsibleButton</class>
   <extends>QWidget</extends>
   <header>ctkCollapsibleButton.h</header>
   <container>1</container>
  </customwidget>
  <customwidget>
   <class>qMRMLWidget</class>
   <extends>QWidget</extends>
   <header>qMRMLWidget.h</header>
   <container>1</container>
  </customwidget>
 </customwidgets>
 <resources/>
 <connections>
  <connection>
   <sender>VRViewer</sender>
   <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
   <receiver>settingsCollapsibleButton</receiver>
   <slot>setMRMLScene(vtkMRMLScene*)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>180</x>
     <y>10</y>
    </hint>
    <hint type="destinationlabel">
     <x>180</x>
     <y>160</y>
    </hint>
   </hints>
  </connection>
 </connections>
